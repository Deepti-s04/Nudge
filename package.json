{
  "name": "nudge",
  "displayName": "Nudge - Focus & Habit Tracker",
  "description": "A subtle distraction blocker and focus timer that gently nudges you back to productive work.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-icons.js && wxt",
    "dev:firefox": "node scripts/generate-icons.js && wxt -b firefox",
    "build": "node scripts/generate-icons.js && wxt build",
    "build:firefox": "node scripts/generate-icons.js && wxt build -b firefox",
    "generate-icons": "node scripts/generate-icons.js",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "node --test tests/**/*.test.mjs",
    "postinstall": "node scripts/generate-icons.js && wxt prepare"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
